{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org2.avi.press/spec/v0/plugin-manifest.schema.json",
  "title": "Org2 plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "name", "version"],
  "properties": {
    "$schema": { "const": "org2:plugin-manifest:v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "org2": { "type": "string" } }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "renderers": {
          "type": "array",
          "items": { "$ref": "#/$defs/renderer" }
        },
        "templates": {
          "type": "array",
          "items": { "$ref": "#/$defs/template" }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface" }
        },
        "hooks": {
          "type": "array",
          "items": { "$ref": "#/$defs/hook" }
        }
      }
    }
  },
  "$defs": {
    "contributionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "packagePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "description": { "type": "string" },
        "entry": { "$ref": "#/$defs/processEntry" }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "languages", "entry"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "description": { "type": "string" },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_+-]{0,63}$" }
        },
        "entry": { "$ref": "#/$defs/processEntry" }
      }
    },
    "processEntry": {
      "allOf": [
        { "$ref": "#/$defs/packagePath" },
        { "pattern": "[.](?:c|m)?js$" }
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "description": { "type": "string" },
        "path": { "$ref": "#/$defs/packagePath" }
      }
    },
    "capabilities": {
      "description": "Optional sandbox capabilities. Corpus writes are never granted; actions and hooks return reviewable proposals.",
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["read-corpus", "network"] }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "contexts", "entry"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["note", "heading", "thread", "run", "approval"] }
        },
        "entry": { "$ref": "#/$defs/processEntry" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "surface": {
      "description": "A workspace app page rendered as sandboxed HTML. The entry returns org2:plugin-render-result:v1 and never writes the corpus.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "entry"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "symbol": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.]{0,79}$" },
        "entry": { "$ref": "#/$defs/processEntry" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "events", "entry"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "description": { "type": "string" },
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "run.created", "run.running", "run.waiting-approval", "run.blocked", "run.completed",
              "run.failed", "run.canceled", "approval.requested", "approval.decided",
              "thread.reply-received", "thread.needs-you", "workflow.dispatched"
            ]
          }
        },
        "entry": { "$ref": "#/$defs/processEntry" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    }
  }
}
