{
  "id": "org2-lifecycle",
  "name": "Celorga Lifecycle",
  "description": "Synchronizes substantial OpenClaw executions into Celorga Run Center.",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "corpusDir": { "type": "string" },
      "stateFile": { "type": "string" },
      "owner": { "type": "string" },
      "trackMainTurns": { "type": "boolean" },
      "trackCron": { "type": "boolean" },
      "trackSubagents": { "type": "boolean" },
      "trackDraftApprovals": { "type": "boolean" },
      "enforceSafeGmailDrafts": { "type": "boolean" },
      "safeGmailDraftCommand": { "type": "string" },
      "syncWaitSeconds": { "type": "number", "minimum": 0 }
    }
  }
}
