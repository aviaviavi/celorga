{
  "$schema": "org2:openorg-performance-corpus-shape:v1",
  "version": 5,
  "description": "Aggregate, privacy-safe union of the root-heavy and zoned OpenOrg corpus layouts. It preserves both workloads without corpus text, file names, IDs, or source paths.",
