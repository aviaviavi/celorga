      },
      {
        "kind": "agents",
        "fileCount": 100
      },
      {
        "kind": "meetings",
        "fileCount": 560
      },
      {
        "kind": "views",
        "fileCount": 1500
      },
      {
        "kind": "other",
        "fileCount": 340
      }
